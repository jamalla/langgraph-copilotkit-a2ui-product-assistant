# =============================================================================
# Copy to .env and fill in.  Every service reads from this ONE root .env file.
# =============================================================================

# --- Required from Part 3 onward (the LangGraph agent's LLM) ---
OPENAI_API_KEY=sk-...

# --- Service wiring (defaults are correct for local dev; change only on port clash) ---

# Where the FastMCP product-catalog server listens.  Read by apps/agent.
# The server binds 127.0.0.1, so the URL says 127.0.0.1 too: on Windows
# "localhost" can resolve to ::1 first and then refuse the connection.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8931
MCP_SERVER_URL=http://127.0.0.1:8931/mcp

# Where `langgraph dev` listens.  Read by apps/web's CopilotKit runtime route.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024

# The graph id declared in apps/agent/langgraph.json.
LANGGRAPH_GRAPH_ID=product_agent

# --- Optional but strongly recommended while learning: LangSmith ---
#
# The journey panel shows a SUMMARY of each turn. LangSmith has the full tree:
# every prompt sent, token counts per call, how long the A2UI subagent took and
# how many times it had to retry before its component tree validated.
#
# `langsmith` is already installed as a dependency of langchain — set these
# three and restart the agent. Nothing else changes, and the journey panel
# starts linking straight to the exact run instead of showing this hint.
#
# Get a key at https://smith.langchain.com/settings
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=a2ui-product-assistant
